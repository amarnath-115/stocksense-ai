# =====================================================================
# Stocksense AI - Configuration & SMS Gateway Setup
# =====================================================================
# Rename or copy this file to `.env` in the same directory:
#   copy .env.example .env
#
# NOTE: If no SMS keys are configured, Stocksense AI runs in
# resilient Demo Fallback Mode (displays OTP on screen for instant testing).
#
# ---------------------------------------------------------------------
# Option 1: Fast2SMS (Recommended for India, Instant Free Signup Credits)
# Signup: https://www.fast2sms.com -> Dev API -> Copy API Authorization Key
# ---------------------------------------------------------------------
FAST2SMS_API_KEY=

# ---------------------------------------------------------------------
# Option 2: Twilio (Global SMS Gateway, Free $15 Trial Credit)
# Signup: https://www.twilio.com -> Console -> Copy SID, Token, Phone Number
# ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------
# Option 3: 2Factor.in (Indian Transactional OTP Service)
# Signup: https://2factor.in -> API Keys
# ---------------------------------------------------------------------
TWOFACTOR_API_KEY=
